# OpenPak region node. Copy to .env and fill in; NEVER commit .env.

# Public IPv4 of this box, the one consoles reach it on.
PUBLIC_IP=203.0.113.9

# Optional: this box's public IPv6 (wanted, not required).
PUBLIC_IPV6=

# The node slug and the node key OpenPak sent you once your application was approved.
# The node key only enrols servers: on first start this server joins as SERVER_NAME and
# keeps its own server key in the announce-state volume. Same node key on every server.
NODE_ID=au-sydney
OPENPAK_NODE_KEY=opnode_...
# Unique per server of this node: [a-z0-9-], e.g. game1, turn1.
SERVER_NAME=s1

# What this server reports (self-declared; see openpak.org/operators for the minimums).
# Your port speed in Mbps, symmetric. Disk: the filesystem mounted at DATA_DIR is measured;
# DISK_SSD=auto reads /sys, or set true/false.
PORT_MBPS=1000
DATA_DIR=/
DISK_SSD=auto
# Roles this server runs, as JSON members. Default: photon + turn + stun on PUBLIC_IP.
# A TURN-only server: ANNOUNCE_SERVICES="turn":"203.0.113.9:3478","stun":"203.0.113.9:3478"
ANNOUNCE_SERVICES=

# Two secrets home shares with its nodes. Ask whoever runs openpak.org.
#   PHOTON_SECRET    - Photon's token-signing secret; without it home's tokens do not validate here.
#   NPLN_TURN_SECRET - what home's Stardew server mints TURN credentials with; coturn must match.
PHOTON_SECRET=change-me
NPLN_TURN_SECRET=change-me

# Where the Photon game server reports its rooms (home's Photon HTTP behind TLS). Default is fine.
# PHOTON_HOME_URL=https://photon.openpak.org
